# Zimmerei & Dachdeckerei Schüll – Apache-Einstellungen (Hostinger)

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8
AddType image/svg+xml .svg
AddType font/woff2 .woff2

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Ohne „www.“ – funktioniert mit jeder Domain (auch der Hostinger-Testadresse).
  # HTTPS erzwingen: im hPanel unter Sicherheit > SSL > „HTTPS erzwingen“ einschalten.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Adressen der alten Website auf die neuen Seiten umleiten
  RewriteRule ^der-betrieb/?$ /betrieb/ [R=301,L]
  RewriteRule ^der-meister/?$ /betrieb/#meister [R=301,L,NE]
  RewriteRule ^die-leistungen/?$ /leistungen/ [R=301,L]
  RewriteRule ^inhalts-artikel/impressum/?$ /impressum/ [R=301,L]
  RewriteRule ^inhalts-artikel/datenschutz/?$ /datenschutz/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
</IfModule>

# Interne Dateien nicht ausliefern
<FilesMatch "^\.user\.ini$">
  Require all denied
</FilesMatch>
